# Скопируйте этот файл в .env и заполните.

# --- ProcessMaker
PM_HOST=https://pm1.starnet.md
PM_WORKSPACE=starnet
PM_USERNAME=ваш_логин
PM_PASSWORD=ваш_пароль
# Какой список проверять: unassigned (Unassigned) | todo (Inbox) | draft | paused
PM_LIST=unassigned

# --- Telegram
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAAA-BBBB
# Ваш chat id (узнать: напишите боту, затем откройте
# https://api.telegram.org/bot<ТОКЕН>/getUpdates). Можно несколько через запятую.
TELEGRAM_CHAT_ID=123456789

# --- Поведение
# Как часто проверять, секунд
CHECK_INTERVAL=60
# 1 = при первом запуске прислать и заявки, которые уже висят в списке
NOTIFY_EXISTING_ON_START=1
# После скольких ошибок подряд прислать предупреждение
ERROR_ALERT_AFTER=5
